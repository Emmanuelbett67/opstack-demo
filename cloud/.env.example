# Copy to .env and fill in from your Grafana Cloud stack's details page
# (grafana.com > My Account > your stack > Prometheus "Details" and Loki "Details").
# .env is gitignored. Never commit the real token.

# Prometheus: "Remote Write Endpoint" and "Username / Instance ID"
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-XX-XXXX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=000000

# Loki: "URL" with /loki/api/v1/push appended, and "User"
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=000000

# An access policy token scoped to metrics:write, logs:write, rules:read and
# rules:write only. Nothing that can read your data or change the stack.
GRAFANA_CLOUD_TOKEN=

# Name this host shows up as on the dashboards.
HOST_NAME=demo-linux-01
